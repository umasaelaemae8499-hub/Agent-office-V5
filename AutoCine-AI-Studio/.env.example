# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# Budget guard. Defaults forbid any paid API call.
MAX_PROJECT_BUDGET_USD=0
ALLOW_PAID_GENERATION=false

# Optional cloud providers (adapters pending API verification)
KLING_API_KEY=
RUNWAYML_API_SECRET=

# Optional: point at a non-default ComfyUI server / install
AUTOCINE_COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_DIR=

# Optional: explicit ffmpeg / ffprobe executables (otherwise PATH is used)
FFMPEG_PATH=
FFPROBE_PATH=
